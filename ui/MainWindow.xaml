<Window x:Class="Executor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Executor"
        Height="640" Width="920"
        MinHeight="440" MinWidth="680"
        WindowStyle="None"
        Background="#0D1117"
        ResizeMode="CanResizeWithGrip">

    <!-- WindowChrome provides native resize + drag while keeping our custom look. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ── Palette ─────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BgMain"        Color="#0D1117"/>
        <SolidColorBrush x:Key="BgPanel"       Color="#161B22"/>
        <SolidColorBrush x:Key="BgInput"       Color="#21262D"/>
        <SolidColorBrush x:Key="BgInputFocus"  Color="#1C2128"/>
        <SolidColorBrush x:Key="BorderNorm"    Color="#30363D"/>
        <SolidColorBrush x:Key="BorderFocus"   Color="#58A6FF"/>
        <SolidColorBrush x:Key="Accent"        Color="#58A6FF"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextSecond"    Color="#7D8590"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#484F58"/>
        <SolidColorBrush x:Key="GreenNorm"     Color="#238636"/>
        <SolidColorBrush x:Key="GreenHover"    Color="#2EA043"/>
        <SolidColorBrush x:Key="GreenPress"    Color="#1A7F37"/>
        <SolidColorBrush x:Key="BlueNorm"      Color="#1F6FEB"/>
        <SolidColorBrush x:Key="BlueHover"     Color="#388BFD"/>
        <SolidColorBrush x:Key="BluePress"     Color="#0D62D1"/>
        <SolidColorBrush x:Key="DangerColor"   Color="#F85149"/>
        <SolidColorBrush x:Key="SuccessColor"  Color="#3FB950"/>

        <!-- ── Text input (process/dll path boxes) ─────────────── -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"              Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground"              Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush"              Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource BorderNorm}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="9,0"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="Height"                  Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                        Value="{StaticResource BorderFocus}"/>
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource BgInputFocus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Green button (Inject) ────────────────────────────── -->
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="Background"       Value="{StaticResource GreenNorm}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="16,0"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background"
                                        Value="{StaticResource GreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background"
                                        Value="{StaticResource GreenPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Blue button (Execute) ────────────────────────────── -->
        <Style x:Key="BlueBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="Background"       Value="{StaticResource BlueNorm}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="20,0"/>
            <Setter Property="Height"           Value="34"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background"
                                        Value="{StaticResource BlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background"
                                        Value="{StaticResource BluePress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost / outline button (Browse, Clear) ───────────── -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="{StaticResource TextSecond}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderNorm}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="14,0"/>
            <Setter Property="Height"           Value="32"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background"
                                        Value="{StaticResource BgInput}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background"
                                        Value="#2D333B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Title-bar icon button ────────────────────────────── -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Foreground"       Value="{StaticResource TextSecond}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Width"            Value="40"/>
            <Setter Property="Height"           Value="36"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background"
                                        Value="{StaticResource BgInput}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close button goes red on hover -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════
         Root layout
    ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>   <!-- 0 – title bar       -->
            <RowDefinition Height="Auto"/> <!-- 1 – inject controls -->
            <RowDefinition Height="1"/>    <!-- 2 – divider         -->
            <RowDefinition Height="*"/>    <!-- 3 – editor          -->
            <RowDefinition Height="1"/>    <!-- 4 – divider         -->
            <RowDefinition Height="54"/>   <!-- 5 – action bar      -->
            <RowDefinition Height="26"/>   <!-- 6 – status bar      -->
        </Grid.RowDefinitions>

        <!-- ── 0 · TITLE BAR ──────────────────────────────────────── -->
        <Grid Grid.Row="0" Background="{StaticResource BgPanel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Drag zone + brand -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="14,0"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                <Ellipse Width="9" Height="9" Fill="#58A6FF" Margin="0,0,9,0"/>
                <TextBlock Text="Executor"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="  · Lua Executor"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11" Margin="0,0,0,0"
                           VerticalAlignment="Bottom" Padding="0,0,0,1"/>
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="─" Style="{StaticResource TitleBtn}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeBtn_Click"/>
                <Button x:Name="MaxBtn" Content="□" Style="{StaticResource TitleBtn}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeBtn_Click"/>
                <Button Content="✕" Style="{StaticResource CloseBtn}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- ── 1 · INJECT CONTROLS ───────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderNorm}" BorderThickness="0,0,0,0">
            <Grid Margin="14,10,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>  <!-- label -->
                    <ColumnDefinition Width="*"/>   <!-- input -->
                    <ColumnDefinition Width="Auto"/><!-- button -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <!-- Process row -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Process" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecond}" FontSize="12"/>
                <TextBox   x:Name="ProcessBox"
                           Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource InputStyle}"
                           Text="RobloxPlayerBeta.exe"/>
                <Button    Grid.Row="0" Grid.Column="2"
                           Content="Inject" Style="{StaticResource GreenBtn}"
                           Margin="8,0,0,0" Click="InjectBtn_Click"/>

                <!-- DLL row -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="DLL" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecond}" FontSize="12"/>
                <TextBox   x:Name="DllPathBox"
                           Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource InputStyle}"
                           Text="C:\xcutor.dll"/>
                <Button    Grid.Row="2" Grid.Column="2"
                           Content="Browse" Style="{StaticResource GhostBtn}"
                           Margin="8,0,0,0" Click="BrowseBtn_Click"/>
            </Grid>
        </Border>

        <!-- ── 2 · DIVIDER ───────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource BorderNorm}"/>

        <!-- ── 3 · EDITOR ────────────────────────────────────────── -->
        <Grid Grid.Row="3" Background="{StaticResource BgMain}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>   <!-- gutter / line nums -->
                <ColumnDefinition Width="1"/>    <!-- gutter border       -->
                <ColumnDefinition Width="*"/>    <!-- code area           -->
            </Grid.ColumnDefinitions>

            <!-- Line number gutter -->
            <Border Grid.Column="0" Background="#0A0E13">
                <ScrollViewer x:Name="LineScroll"
                             VerticalScrollBarVisibility="Hidden"
                             HorizontalScrollBarVisibility="Disabled"
                             IsHitTestVisible="False"
                             Padding="0,8,0,0">
                    <TextBlock x:Name="LineNums"
                               Text="1"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="13"
                               TextAlignment="Right"
                               Padding="0,0,10,0"
                               LineHeight="19.5"/>
                </ScrollViewer>
            </Border>

            <!-- Gutter separator -->
            <Border Grid.Column="1" Background="{StaticResource BorderNorm}"/>

            <!-- Code TextBox -->
            <TextBox x:Name="EditorBox"
                     Grid.Column="2"
                     Background="Transparent"
                     Foreground="{StaticResource TextPrimary}"
                     CaretBrush="{StaticResource Accent}"
                     SelectionBrush="#264F78"
                     BorderBrush="Transparent"
                     BorderThickness="0"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="13"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     Padding="14,8,14,8"
                     TextChanged="EditorBox_TextChanged"
                     Loaded="EditorBox_Loaded">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                     Background="Transparent"
                                     Padding="{TemplateBinding Padding}"/>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>

        <!-- ── 4 · DIVIDER ───────────────────────────────────────── -->
        <Border Grid.Row="4" Background="{StaticResource BorderNorm}"/>

        <!-- ── 5 · ACTION BAR ────────────────────────────────────── -->
        <Border Grid.Row="5" Background="{StaticResource BgPanel}">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶  Execute" Style="{StaticResource BlueBtn}"
                            Click="ExecuteBtn_Click"/>
                    <Button Content="Clear" Style="{StaticResource GhostBtn}"
                            Margin="8,0,0,0" Click="ClearBtn_Click"/>
                </StackPanel>

                <!-- Injected badge -->
                <StackPanel x:Name="InjectedBadge"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessColor}"
                             Margin="0,0,6,0"/>
                    <TextBlock x:Name="InjectedLabel"
                               Foreground="{StaticResource TextSecond}"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 6 · STATUS BAR ────────────────────────────────────── -->
        <Border Grid.Row="6" Background="#010409">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="14,0">
                <Ellipse x:Name="StatusDot"
                         Width="6" Height="6"
                         Fill="{StaticResource TextMuted}"
                         Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource TextSecond}"
                           FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
